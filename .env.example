# Chave do Resend para o formulário de contato. Sem ela, o formulário mostra
# o estado de erro com as alternativas de WhatsApp e e-mail, sem quebrar.
RESEND_API_KEY=

# Remetente dos e-mails do formulário. Precisa ser de um domínio verificado
# no Resend, por exemplo: Site <contato@mariademoraes.adv.br>
EMAIL_REMETENTE=
